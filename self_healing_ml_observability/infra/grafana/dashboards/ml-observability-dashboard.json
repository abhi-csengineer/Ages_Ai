{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "timeseries",
      "title": "Traffic (req/s)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(ml_inference_requests_total[1m])", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p95",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ml_inference_latency_seconds_bucket[1m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors (total)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [{ "expr": "ml_inference_errors_total", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Saturation",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [{ "expr": "ml_inference_saturation", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Drift (PSI / MMD)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [{ "expr": "ml_drift_score", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Bias Score",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [{ "expr": "ml_bias_score", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Top Drift Feature (SHAP proxy)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [{ "expr": "ml_top_drift_feature_score", "refId": "A" }]
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["ml", "observability"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "title": "Self-Healing ML Observability",
  "version": 1
}
